# ============================================================================
# Telegram API (получить на https://my.telegram.org/apps)
# ============================================================================
# Эти значения одни на всё приложение - привязаны не к конкретному аккаунту,
# а к "приложению". Любой ваш аккаунт может ими пользоваться.
TG_API_ID=1234567
TG_API_HASH=abcdef1234567890abcdef1234567890

# ============================================================================
# ID Telegram-группы, в которой будут общаться агенты
# ============================================================================
# Самый простой способ узнать:
# 1. Добавьте бота @userinfobot или @getmyid_bot в группу
# 2. Или временно запустите login.py с одним аккаунтом и напишите там
#    что-нибудь - в логах будет ID чата.
# Для групп ID начинается с -100... (супергруппы) или -... (обычные группы).
TG_GROUP_ID=-1001234567890

# ============================================================================
# LLM (OpenAI-совместимый endpoint)
# ============================================================================
# === ВАРИАНТ 1: Google Gemini (РЕКОМЕНДУЕТСЯ — бесплатно) ===
# Получить ключ: https://aistudio.google.com/app/apikey
# Бесплатный лимит: ~1500 запросов/день, модели gemini-2.5-flash/pro
#
# === ВАРИАНТ 2: OpenRouter (бесплатные модели) ===
# Зарегистрироваться: https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL=google/gemini-2.5-flash:free
#
# === ВАРИАНТ 3: Локальная модель (Ollama / LM Studio) ===
# Ollama:    LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama   LLM_MODEL=qwen2.5:7b
# LM Studio: LLM_BASE_URL=http://localhost:1234/v1    LLM_API_KEY=lmstudio LLM_MODEL=<имя модели>
#
# === ВАРИАНТ 4: OpenAI (платно) ===
# LLM_BASE_URL=https://api.openai.com/v1  LLM_API_KEY=sk-...  LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=YOUR_GEMINI_API_KEY
LLM_MODEL=gemini-2.5-flash

# ============================================================================
# Поведение агентов
# ============================================================================
# Минимальная и максимальная задержка перед ответом (секунды).
# Имитация набора текста - снижает риск бана и делает диалог "живее".
REPLY_DELAY_MIN=4
REPLY_DELAY_MAX=18

# Сколько последних сообщений из группы скармливать LLM как контекст.
CONTEXT_WINDOW=40

# Сколько подряд реплик может оставить один агент, прежде чем будет вынужден
# уступить слово. Защита от зацикливания "агенты болтают друг с другом".
MAX_CONSECUTIVE_REPLIES=2

# Лимит шагов (раундов вызова инструментов) для одного агента за одну реплику.
# Если агент делает много изменений (пишет код, ставит пакеты), увеличьте этот лимит.
MAX_ROUNDS=20

# Куда dev-агент сохраняет сгенерированные сайты (путь относительно корня).
WORKSPACE_DIR=./workspace

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================================================
# Дашборд (3D-визуализация команды)
# ============================================================================
# Хост и порт для веб-дашборда. По умолчанию 0.0.0.0:8000 (доступен в сети).
# Если хотите только локальный доступ: DASHBOARD_HOST=127.0.0.1
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
